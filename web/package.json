{
  "name": "tanstack-start-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "A TanStack Start starter with React, TypeScript, TanStack Query, Tailwind CSS, and streaming SSR.",
  "author": "RingoTangs",
  "license": "MIT",
  "homepage": "https://github.com/RingoTangs/tanstack-start-app#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RingoTangs/tanstack-start-app.git"
  },
  "bugs": {
    "url": "https://github.com/RingoTangs/tanstack-start-app/issues"
  },
  "keywords": [
    "tanstack-start",
    "tanstack-router",
    "tanstack-query",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "ssr",
    "streaming",
    "starter"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
    "check:fix": "pnpm lint:fix && pnpm format:fix"
  },
  "dependencies": {
    "@ringotangs/react-theme": "^0.1.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.59.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@ringotangs/tsconfig": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  }
}
